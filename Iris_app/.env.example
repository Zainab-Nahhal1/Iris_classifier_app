# Example environment variables for Iris classifier app
# Copy this file to ".env" and replace the placeholders with your own values.

# Database connection string should use PostgreSQL format.
# For example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Docker-related variables (used by docker-compose):
POSTGRES_USER=appuser
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=appdb
